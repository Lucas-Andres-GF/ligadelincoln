---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import { createClient } from '@supabase/supabase-js'
import { hasCompleteScore, isMatchPlayed } from '../../utils/matchState'

const { slug } = Astro.params
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

// Slug pattern: t{torneo_id}-p{partido_id}-{local}-vs-{visita}
const match = slug.match(/^t(\d+)-p(\d+)/)
if (!match) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const torneoId = parseInt(match[1], 10)
const partidoId = parseInt(match[2], 10)

if (!Number.isSafeInteger(torneoId) || !Number.isSafeInteger(partidoId)) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
const supabase = createClient(supabaseUrl, supabaseKey)

const { data: partido, error: partidoError } = await supabase
  .from('partidos')
  .select('id, torneo_id, categoria_id, fecha_id, dia, hora, local_id, visitante_id, goles_local, goles_visitante, estado, dt_local, dt_visitante, arbitro')
  .eq('id', partidoId)
  .eq('torneo_id', torneoId)
  .maybeSingle()

if (partidoError || !partido || !isMatchPlayed(partido)) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

const { data: clubes, error: clubesError } = await supabase
  .from('clubes')
  .select('id, nombre')
  .in('id', [partido.local_id, partido.visitante_id])

if (clubesError || !clubes) {
  return new Response('Server Error', { status: 500, statusText: 'Server Error' })
}

const clubMap = Object.fromEntries(clubes.map((c) => [c.id, c.nombre]))
const nombreLocal = clubMap[partido.local_id]
const nombreVisita = clubMap[partido.visitante_id]

if (!nombreLocal || !nombreVisita) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' })
}

// alineaciones has no torneo_id. partido.id is safe here because this
// record was resolved from exact torneo_id + partido.id.
const { data: aliData, error: alineacionesError } = await supabase
  .from('alineaciones')
  .select('partido_id, equipo_id, numero, nombre, es_titular, goleo, goles_en_contra, roja')
  .eq('partido_id', partido.id)
  .order('equipo_id')
  .order('numero')

const alineaciones = aliData || []

// Configure Edge cache: 60s max-age, 300s stale-while-revalidate for fast response
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300')

const aliLocal = alineaciones.filter(a => a.equipo_id === partido.local_id)
const aliVisita = alineaciones.filter(a => a.equipo_id === partido.visitante_id)

const escudos = {
  1: '/escudos/argentino.png', 2: '/escudos/atl.pasteur.png', 3: '/escudos/atl.roberts.png',
  4: '/escudos/ca.pintense.png', 5: '/escudos/caset.png', 6: '/escudos/dep.arenaza.png',
  7: '/escudos/dep.pinto.png', 8: '/escudos/el.linqueño.png', 9: '/escudos/juventud.unida.png',
  10: '/escudos/san.martin.png', 11: '/escudos/villa.francia.png',
}

function formatearDia(dia) {
  if (!dia) return null
  if (dia.includes('/')) return dia
  if (dia.includes('-')) {
    const [aa, mm, dd] = dia.split('-')
    if (aa && mm && dd) return `${dd}/${mm}`
  }
  return dia
}

function formatearHora(hora) {
  if (!hora) return null
  return `${hora.slice(0, 5)}hs`
}

function normalizeGoalCount(value) {
  const count = Number(value)
  return Number.isSafeInteger(count) && count > 0 ? count : 0
}

function getPlayerGoalMarkers(player) {
  const normalGoals = Array(normalizeGoalCount(player?.goleo)).fill('⚽')
  const ownGoals = Array(normalizeGoalCount(player?.goles_en_contra)).fill('(E/C) ⚽')
  return [...normalGoals, ...ownGoals].join(' ')
}

const diaPartido = formatearDia(partido.dia)
const horaPartido = formatearHora(partido.hora)
const estadoNormalizado = String(partido.estado || '').trim().toLowerCase()
const seJugo = isMatchPlayed(partido)
const tieneResultadoCompleto = hasCompleteScore(partido)
const resultadoLabel = tieneResultadoCompleto
  ? `${partido.goles_local}-${partido.goles_visitante}`
  : null
const esSuspendido = estadoNormalizado === 'suspendido'
const tieneObservacion = Boolean(partido.estado && !['programado', 'jugado', 'libre'].includes(estadoNormalizado))

let estadoHorarioLabel = horaPartido
if (seJugo) {
  estadoHorarioLabel = 'JUGADO'
} else if (esSuspendido) {
  estadoHorarioLabel = 'SUSPENDIDO'
} else if (tieneObservacion) {
  estadoHorarioLabel = partido.estado
}

const fechaHoraLabel = (esSuspendido || tieneObservacion)
  ? estadoHorarioLabel
  : [diaPartido, estadoHorarioLabel].filter(Boolean).join(' - ')

const pageTitle = resultadoLabel
  ? `${nombreLocal} ${resultadoLabel} ${nombreVisita} - Liga De Lincoln`
  : `${nombreLocal} vs ${nombreVisita} - Liga De Lincoln`
const pageDescription = `Resultado, alineaciones, titulares, suplentes y datos del partido ${nombreLocal} vs ${nombreVisita} del torneo ${partido.torneo_id} de la Liga Amateur de Deportes de Lincoln.`
const matchStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${nombreLocal} vs ${nombreVisita}`,
  description: pageDescription,
  url: new URL(`/partido/${slug}?torneo=${partido.torneo_id}`, Astro.site || 'https://ligadelincoln.com').href,
  sport: 'Soccer',
  competitor: [
    { '@type': 'SportsTeam', name: nombreLocal },
    { '@type': 'SportsTeam', name: nombreVisita },
  ],
  eventStatus: 'https://schema.org/EventCompleted',
}

if (partido.dia) {
  matchStructuredData.startDate = partido.dia
}
---

<Layout title={pageTitle} description={pageDescription} structuredData={matchStructuredData}>
  <div class="mx-auto w-full max-w-6xl">
    <section class="relative mb-6 overflow-hidden rounded-2xl border border-green-800/60 bg-[#0a2b19] px-4 py-6 shadow-[0_24px_60px_rgba(0,0,0,0.24)] sm:px-8 sm:py-8">
      <div class="absolute inset-y-0 left-1/2 w-px bg-green-400/[0.04]" aria-hidden="true"></div>
    <div class="relative mb-7 text-center">
      <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
        <p class="inline-block rounded-full border border-green-400/20 bg-green-400/[0.06] px-3 py-1 font-[var(--font-display)] text-sm font-black uppercase tracking-widest text-green-400">
          Fecha {partido.fecha_id}
        </p>
        <p class="inline-block rounded-full border border-yellow-300/30 bg-yellow-300/10 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-yellow-200">
          Torneo {partido.torneo_id}
        </p>
      </div>
      {fechaHoraLabel && (
        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[11px] font-bold uppercase tracking-widest text-green-300/80">
          <span class="rounded-full border border-green-800/50 bg-green-950/30 px-3 py-1">
            {fechaHoraLabel}
          </span>
        </div>
      )}
      <h1 class="sr-only">{nombreLocal} vs {nombreVisita}: resultado y alineaciones</h1>
    </div>

    <div class="relative mx-auto mb-8 grid max-w-4xl grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 sm:gap-8">
      <div class="flex min-w-0 flex-col items-center gap-3">
        <img src={escudos[partido.local_id]} alt={nombreLocal} class="h-20 w-20 object-contain drop-shadow-[0_10px_18px_rgba(0,0,0,0.38)] sm:h-28 sm:w-28" />
        <span class="text-center font-[var(--font-display)] text-base font-black uppercase leading-tight tracking-wide text-green-100 sm:text-2xl">{nombreLocal}</span>
      </div>
      
      <div class="flex items-center gap-3 rounded-2xl border border-yellow-300/15 bg-black/10 px-3 py-3 sm:px-6">
        <span class="font-[var(--font-display)] text-4xl font-black tabular-nums text-yellow-200 sm:text-6xl">
          {resultadoLabel || 'Resultado no disponible'}
        </span>
      </div>
      
      <div class="flex min-w-0 flex-col items-center gap-3">
        <img src={escudos[partido.visitante_id]} alt={nombreVisita} class="h-20 w-20 object-contain drop-shadow-[0_10px_18px_rgba(0,0,0,0.38)] sm:h-28 sm:w-28" />
        <span class="text-center font-[var(--font-display)] text-base font-black uppercase leading-tight tracking-wide text-green-100 sm:text-2xl">{nombreVisita}</span>
      </div>
    </div>

    {/* Staff: DT y Árbitro */}
    {(partido.dt_local || partido.dt_visitante || partido.arbitro) && (
      <div class="relative mx-auto mb-1 grid max-w-3xl grid-cols-1 gap-3 rounded-xl border border-green-800/50 bg-green-950/20 px-4 py-3 text-sm sm:grid-cols-3 sm:gap-8">
        {partido.dt_local && (
          <div class="text-center">
            <span class="text-[9px] font-bold uppercase tracking-widest text-green-600">D.T. Local</span>
            <div class="font-semibold text-green-200">{partido.dt_local}</div>
          </div>
        )}
        {partido.arbitro && (
          <div class="text-center">
            <span class="text-[9px] font-bold uppercase tracking-widest text-green-600">Árbitro</span>
            <div class="font-semibold text-green-200">{partido.arbitro}</div>
          </div>
        )}
        {partido.dt_visitante && (
          <div class="text-center">
            <span class="text-[9px] font-bold uppercase tracking-widest text-green-600">D.T. Visita</span>
            <div class="font-semibold text-green-200">{partido.dt_visitante}</div>
          </div>
        )}
      </div>
    )}
    </section>

    {alineacionesError ? (
      <div class="text-center py-8 text-red-300" role="alert">
        No se pudieron cargar las alineaciones de este partido.
      </div>
    ) : alineaciones.length === 0 ? (
      <div class="text-center py-8 text-green-600">
        No hay alineaciones disponibles para este partido.
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <section class="overflow-hidden rounded-2xl border border-green-800/60 bg-[#0b2e1a]/95 p-5 shadow-[0_20px_50px_rgba(0,0,0,0.2)] sm:p-6">
          <div class="mb-5 flex items-center gap-3 border-b border-green-800/50 pb-4">
            <img src={escudos[partido.local_id]} alt="" class="h-10 w-10 object-contain" />
            <span class="font-[var(--font-display)] text-xl font-black uppercase tracking-wide text-green-100">{nombreLocal}</span>
          </div>

          <div class="space-y-3">
            <div>
              <span class="mb-3 block text-[9px] font-black uppercase tracking-[0.2em] text-green-600">Titulares</span>
              <div class="space-y-1">
                {aliLocal.filter(a => a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-green-400/15 text-center font-bold text-green-400">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {getPlayerGoalMarkers(j) ? ` ${getPlayerGoalMarkers(j)}` : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <span class="mb-3 block text-[9px] font-black uppercase tracking-[0.2em] text-green-600">Suplentes</span>
              <div class="space-y-1">
                {aliLocal.filter(a => !a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-900/40 rounded flex items-center justify-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {getPlayerGoalMarkers(j) ? ` ${getPlayerGoalMarkers(j)}` : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="overflow-hidden rounded-2xl border border-green-800/60 bg-[#0b2e1a]/95 p-5 shadow-[0_20px_50px_rgba(0,0,0,0.2)] sm:p-6">
          <div class="mb-5 flex items-center gap-3 border-b border-green-800/50 pb-4">
            <img src={escudos[partido.visitante_id]} alt="" class="h-10 w-10 object-contain" />
            <span class="font-[var(--font-display)] text-xl font-black uppercase tracking-wide text-green-100">{nombreVisita}</span>
          </div>

          <div class="space-y-3">
            <div>
              <span class="mb-3 block text-[9px] font-black uppercase tracking-[0.2em] text-green-600">Titulares</span>
              <div class="space-y-1">
                {aliVisita.filter(a => a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-green-400/15 text-center font-bold text-green-400">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {getPlayerGoalMarkers(j) ? ` ${getPlayerGoalMarkers(j)}` : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <span class="mb-3 block text-[9px] font-black uppercase tracking-[0.2em] text-green-600">Suplentes</span>
              <div class="space-y-1">
                {aliVisita.filter(a => !a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-900/40 rounded flex items-center justify-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {getPlayerGoalMarkers(j) ? ` ${getPlayerGoalMarkers(j)}` : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      </div>
    )}
  </div>
</Layout>
