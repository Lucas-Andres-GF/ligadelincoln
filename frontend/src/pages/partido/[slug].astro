---
import Layout from '../../layouts/Layout.astro'
import { createClient } from '@supabase/supabase-js'
import { slugify } from '../../utils/slugify'

export async function getStaticPaths() {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  const supabase = createClient(supabaseUrl, supabaseKey)

  const { data: torneos, error: torneosError } = await supabase
    .from('torneos')
    .select('id')
    .order('id')

  if (torneosError) throw torneosError

  // Enumerate each immutable tournament scope independently. Never issue a
  // cross-tournament partidos read while generating static detail routes.
  const partidosPorTorneo = await Promise.all(
    (torneos || []).map(async (torneo) => {
      const torneoId = Number(torneo.id)
      if (!Number.isSafeInteger(torneoId) || torneoId <= 0) {
        throw new Error(`Invalid torneo_id while generating match paths: ${torneo.id}`)
      }

      const { data, error } = await supabase
        .from('partidos')
        .select('id, torneo_id, categoria_id, fecha_id, dia, hora, local_id, visitante_id, goles_local, goles_visitante, estado, dt_local, dt_visitante, arbitro')
        .eq('torneo_id', torneoId)
        .eq('categoria_id', 1)
        .eq('estado', 'jugado')

      if (error) throw error
      return data || []
    }),
  )
  const partidos = partidosPorTorneo.flat()

  const { data: clubes, error: clubesError } = await supabase.from('clubes').select('id, nombre')
  if (clubesError) throw clubesError

  const clubNames = Object.fromEntries((clubes || []).map((club) => [club.id, club.nombre]))
  const usedPaths = new Set()

  return partidos.flatMap((partido) => {
    const nombreLocal = clubNames[partido.local_id]
    const nombreVisita = clubNames[partido.visitante_id]
    if (!partido.id || !partido.torneo_id || !nombreLocal || !nombreVisita) return []

    const slug = `t${partido.torneo_id}-p${partido.id}-${slugify(nombreLocal)}-vs-${slugify(nombreVisita)}`
    if (usedPaths.has(slug)) return []
    usedPaths.add(slug)

    return [{
      params: { slug },
      props: { partido, nombreLocal, nombreVisita },
    }]
  })
}

const { slug } = Astro.params
const { partido, nombreLocal, nombreVisita } = Astro.props

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
const supabase = createClient(supabaseUrl, supabaseKey)

// alineaciones has no torneo_id. partido.id is safe here because this props
// record was generated from one exact torneo_id + partido.id route identity.
const { data: aliData, error: alineacionesError } = await supabase
  .from('alineaciones')
  .select('partido_id, equipo_id, numero, nombre, es_titular, goleo, roja')
  .eq('partido_id', partido.id)
  .order('equipo_id')
  .order('numero')

const alineaciones = aliData || []

const aliLocal = alineaciones.filter(a => a.equipo_id === partido.local_id)
const aliVisita = alineaciones.filter(a => a.equipo_id === partido.visitante_id)

const escudos = {
  1: '/escudos/argentino.png', 2: '/escudos/atl.pasteur.png', 3: '/escudos/atl.roberts.png',
  4: '/escudos/ca.pintense.png', 5: '/escudos/caset.png', 6: '/escudos/dep.arenaza.png',
  7: '/escudos/dep.pinto.png', 8: '/escudos/el.linqueño.png', 9: '/escudos/juventud.unida.png',
  10: '/escudos/san.martin.png', 11: '/escudos/villa.francia.png',
}

function formatearDia(dia) {
  if (!dia) return null
  if (dia.includes('/')) return dia
  if (dia.includes('-')) {
    const [aa, mm, dd] = dia.split('-')
    if (aa && mm && dd) return `${dd}/${mm}`
  }
  return dia
}

function formatearHora(hora) {
  if (!hora) return null
  return `${hora.slice(0, 5)}hs`
}

const diaPartido = formatearDia(partido.dia)
const horaPartido = formatearHora(partido.hora)
const seJugo = partido.estado === 'jugado' || (partido.goles_local !== null && partido.goles_visitante !== null)
const estadoHorarioLabel = seJugo ? 'JUGADO' : horaPartido
const fechaHoraLabel = [diaPartido, estadoHorarioLabel].filter(Boolean).join(' - ')

const pageTitle = `${nombreLocal} ${partido.goles_local ?? 0}-${partido.goles_visitante ?? 0} ${nombreVisita} - Liga De Lincoln`
const pageDescription = `Resultado, alineaciones, titulares, suplentes y datos del partido ${nombreLocal} vs ${nombreVisita} del torneo ${partido.torneo_id} de la Liga Amateur de Deportes de Lincoln.`
const matchStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${nombreLocal} vs ${nombreVisita}`,
  description: pageDescription,
  url: new URL(`/partido/${slug}?torneo=${partido.torneo_id}`, Astro.site || 'https://ligadelincoln.com').href,
  sport: 'Soccer',
  competitor: [
    { '@type': 'SportsTeam', name: nombreLocal },
    { '@type': 'SportsTeam', name: nombreVisita },
  ],
  eventStatus: 'https://schema.org/EventCompleted',
}

if (partido.dia) {
  matchStructuredData.startDate = partido.dia
}
---

<Layout title={pageTitle} description={pageDescription} structuredData={matchStructuredData}>
  <div class="max-w-4xl mx-auto px-4 py-6">
    <div class="text-center mb-8">
      <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
        <p class="inline-block px-3 py-0.5 text-[14px] font-bold uppercase tracking-widest text-green-400 border border-green-700/40 rounded-full bg-green-900/20">
          Fecha {partido.fecha_id}
        </p>
        <p class="inline-block px-3 py-0.5 text-[11px] font-bold uppercase tracking-widest text-yellow-200 border border-yellow-300/30 rounded-full bg-yellow-300/10">
          Torneo {partido.torneo_id}
        </p>
      </div>
      {fechaHoraLabel && (
        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[11px] font-bold uppercase tracking-widest text-green-300/80">
          <span class="rounded-full border border-green-800/50 bg-green-950/30 px-3 py-1">
            {fechaHoraLabel}
          </span>
        </div>
      )}
      <h1 class="sr-only">{nombreLocal} vs {nombreVisita}: resultado y alineaciones</h1>
    </div>

    <div class="flex items-center justify-center gap-4 mb-8">
      <div class="flex flex-col items-center gap-2">
        <img src={escudos[partido.local_id]} alt={nombreLocal} class="w-16 h-16 object-contain" />
        <span class="text-green-100 font-bold text-sm text-center">{nombreLocal}</span>
      </div>
      
      <div class="flex items-center gap-3">
        <span class="text-4xl font-black text-green-400">
          {partido.goles_local ?? 0}-{partido.goles_visitante ?? 0}
        </span>
      </div>
      
      <div class="flex flex-col items-center gap-2">
        <img src={escudos[partido.visitante_id]} alt={nombreVisita} class="w-16 h-16 object-contain" />
        <span class="text-green-100 font-bold text-sm text-center">{nombreVisita}</span>
      </div>
    </div>

    {/* Staff: DT y Árbitro */}
    {(partido.dt_local || partido.dt_visitante || partido.arbitro) && (
      <div class="flex justify-center gap-8 mb-6 text-sm">
        {partido.dt_local && (
          <div class="text-center">
            <span class="text-green-500 text-xs uppercase">D.T. Local</span>
            <div class="text-green-300">{partido.dt_local}</div>
          </div>
        )}
        {partido.arbitro && (
          <div class="text-center">
            <span class="text-green-500 text-xs uppercase">Árbitro</span>
            <div class="text-green-300">{partido.arbitro}</div>
          </div>
        )}
        {partido.dt_visitante && (
          <div class="text-center">
            <span class="text-green-500 text-xs uppercase">D.T. Visita</span>
            <div class="text-green-300">{partido.dt_visitante}</div>
          </div>
        )}
      </div>
    )}

    {alineacionesError ? (
      <div class="text-center py-8 text-red-300" role="alert">
        No se pudieron cargar las alineaciones de este partido.
      </div>
    ) : alineaciones.length === 0 ? (
      <div class="text-center py-8 text-green-600">
        No hay alineaciones disponibles para este partido.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#143814] rounded-xl border border-green-900/40 p-4">
          <div class="flex items-center gap-2 mb-4">
            <img src={escudos[partido.local_id]} alt="" class="w-8 h-8 object-contain" />
            <span class="text-green-400 font-bold">{nombreLocal}</span>
          </div>

          <div class="space-y-3">
            <div>
              <span class="text-xs text-green-500 uppercase block mb-2">Titulares</span>
              <div class="space-y-1">
                {aliLocal.filter(a => a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-500/20 text-green-400 rounded flex items-center justify-center font-bold text-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {j.goleo > 0 ? ' ⚽'.repeat(j.goleo) : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <span class="text-xs text-green-500 uppercase block mb-2">Suplentes</span>
              <div class="space-y-1">
                {aliLocal.filter(a => !a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-900/40 rounded flex items-center justify-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {j.goleo > 0 ? ' ⚽'.repeat(j.goleo) : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="bg-[#143814] rounded-xl border border-green-900/40 p-4">
          <div class="flex items-center gap-2 mb-4">
            <img src={escudos[partido.visitante_id]} alt="" class="w-8 h-8 object-contain" />
            <span class="text-green-400 font-bold">{nombreVisita}</span>
          </div>

          <div class="space-y-3">
            <div>
              <span class="text-xs text-green-500 uppercase block mb-2">Titulares</span>
              <div class="space-y-1">
                {aliVisita.filter(a => a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-500/20 text-green-400 rounded flex items-center justify-center font-bold text-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {j.goleo > 0 ? ' ⚽'.repeat(j.goleo) : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
            <div>
              <span class="text-xs text-green-500 uppercase block mb-2">Suplentes</span>
              <div class="space-y-1">
                {aliVisita.filter(a => !a.es_titular && a.nombre && a.nombre !== '0').map(j => (
                  <div key={j.numero} class="flex items-center gap-2 text-xs">
                    <span class="w-6 h-6 bg-green-900/40 rounded flex items-center justify-center">
                      {j.numero}
                    </span>
                    <span class="text-green-300">
                      {j.nombre}
                      {j.goleo > 0 ? ' ⚽'.repeat(j.goleo) : ''}
                      {j.roja ? ' 🟥' : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
