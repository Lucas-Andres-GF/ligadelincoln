[Unit]
Description=Consultar goleadores oficiales los lunes y martes de 09:00 a medianoche (hora argentina)

[Timer]
OnCalendar=Mon,Tue *-*-* 09..23:00:00 America/Argentina/Buenos_Aires
OnCalendar=Tue,Wed *-*-* 00:00:00 America/Argentina/Buenos_Aires
Persistent=true

[Install]
WantedBy=timers.target
